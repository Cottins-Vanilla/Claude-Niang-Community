#!/bin/sh
# Checks identity, messages and files of every commit that no remote has yet.
# Rules: .claude/skills/commit-hygiene/SKILL.md
command -v node >/dev/null 2>&1 || { echo "commit-hygiene: 需要 Node.js 才能检查推送" >&2; exit 1; }
exec node "$(git rev-parse --show-toplevel)/tools/commit-hygiene.mjs" --push
